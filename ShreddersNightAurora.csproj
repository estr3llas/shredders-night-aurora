<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ShreddersNightAurora</AssemblyName>
    <RootNamespace>ShreddersNightAurora</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Override on the command line: dotnet build -p:GameDir="D:\Steam\...\Shredders" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Shredders</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(MLDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Il2Cpplirp.scripts.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Il2Cpplirp.gamebase.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Il2CppTropos.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\Unity.Postprocessing.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- dotnet build -p:Deploy=true copies the DLL into the game's Mods folder. -->
  <Target Name="DeployToMods" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>

</Project>
